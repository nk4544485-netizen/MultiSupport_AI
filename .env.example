# MongoDB Connection string (Atlas or Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/multisupport_ai?retryWrites=true&w=majority

# Groq LLM API Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx

# Secret Key for JWT encryption signing
JWT_SECRET=your_super_secret_key_change_me_in_production
